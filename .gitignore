# Python bytecode and interpreter caches
__pycache__/
*.py[cod]
*$py.class

# Local Python environments (the preserved environment manifests remain tracked)
.venv/
venv/
work/cadenv/

# Test, type-check, lint, and coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Disposable runtime/cache directories
.tmp/
tmp/
work/.cache/
work/spreadsheet_runtime/node_modules/
node_modules/

# Disposable logs
*.log
npm-debug.log*
pnpm-debug.log*

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
